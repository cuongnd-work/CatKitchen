// CatSkin.effect
CCEffect %{
  techniques:
    - name: default
      passes:
        - vert: legacy/main-functions/general-vs:vert
          frag: cat-skin-fs:frag
          blendState:
            targets:
              - blend: true
                blendSrc: src_alpha
                blendDst: one_minus_src_alpha
          rasterizerState:
            cullMode: none
          properties:
            SkinColor:      { value: [1.0, 0.9, 0.7, 1.0], editor: { type: color } }
            NoiseColor:     { value: [1.0, 0.7, 0.3, 1.0], editor: { type: color } }
            NoiseScaleX:    { value: 8.0 }
            NoiseScaleY:    { value: 1.8 }
            NoiseOffsetX:   { value: 0.0 }
            NoiseOffsetY:   { value: 0.0 }
            NoiseToggle:    { value: 1.0 }
            TextureToggle:  { value: 0.0 }
            SymetryToggle:  { value: 0.0 }
            Texture2D:      { value: white, editor: { type: texture } }
}%


CCProgram cat-skin-fs %{
  precision highp float;

  #include <legacy/output>

  in vec2 v_uv;
  in vec3 v_normal;

  uniform sampler2D Texture2D;

  layout(set = 2, binding = 0) uniform Material {
    vec4 SkinColor;
    vec4 NoiseColor;
    float NoiseScaleX;
    float NoiseScaleY;
    float NoiseOffsetX;
    float NoiseOffsetY;
    float NoiseToggle;
    float TextureToggle;
    float SymetryToggle;
  };

  //------------------------------------------------------
  // Long fur-like stripes noise (không phải noise chấm)
  //------------------------------------------------------
  float stripeNoise(vec2 uv) {
    uv.x = uv.x * NoiseScaleX + NoiseOffsetX;
    uv.y = uv.y * NoiseScaleY + NoiseOffsetY;

    float line = sin(uv.x * 12.0) * 0.4 + sin(uv.y * 3.0) * 0.6;

    return smoothstep(0.3, 0.7, line);
  }

  vec2 applySymmetry(vec2 uv) {
    if (SymetryToggle > 0.5) uv.x = 1.0 - uv.x;
    return uv;
  }

  //------------------------------------------------------
  // Toon lighting (RẤT SÁNG – KHÔNG BÓNG)
  //------------------------------------------------------
  float toonLight(vec3 normal) {
    vec3 L = normalize(vec3(0.4, 0.5, 1.0));
    float NdotL = max(dot(normal, L), 0.0);
    return step(0.5, NdotL);   // 2 tone: sáng / tối
  }

  vec4 frag() {
    vec2 uv = applySymmetry(v_uv);
    vec4 base = SkinColor;

    // Fur stripe noise (viền lông dài giống Unity)
    if (NoiseToggle > 0.5) {
      float n = stripeNoise(uv);
      base.rgb = mix(base.rgb, NoiseColor.rgb, n);
    }

    // Texture layer
    if (TextureToggle > 0.5) {
      base *= texture(Texture2D, uv);
    }

    // Toon light
    float lightStep = toonLight(normalize(v_normal));

    // Làm sáng toàn bộ – không làm tối đi
    float lightBoost = mix(0.85, 1.15, lightStep);

    base.rgb *= lightBoost;

    return CCFragOutput(base);
  }
}%
