// CatSkin.effect
CCEffect %{
  techniques:
    - name: default
      passes:
        - vert: legacy/main-functions/general-vs:vert
          frag: cat-skin-fs:frag
          rasterizerState:
            cullMode: none
          properties:
            SkinColor:      { value: [1.0, 0.9, 0.7, 1.0], editor: { type: color } }
            NoiseColor:     { value: [1.0, 0.7, 0.3, 1.0], editor: { type: color } }

            NoiseScaleX:    { value: 1.0 }
            NoiseScaleY:    { value: 1.0 }
            NoiseOffsetX:   { value: 0.0 }
            NoiseOffsetY:   { value: 0.0 }

            NoiseToggle:    { value: 0.0 }
            TextureToggle:  { value: 0.0 }
            SymetryToggle:  { value: 0.0 }

            Texture2D:      { value: white, editor: { type: texture } }
}%


CCProgram cat-skin-fs %{
  precision highp float;
  #include <legacy/output>

  in vec2 v_uv;
  in vec3 v_normal;

  uniform sampler2D Texture2D;

  layout(set = 2, binding = 0) uniform Material {
    vec4 SkinColor;
    vec4 NoiseColor;

    float NoiseScaleX;
    float NoiseScaleY;
    float NoiseOffsetX;
    float NoiseOffsetY;

    float NoiseToggle;
    float TextureToggle;
    float SymetryToggle;
  };

  // ======================================================
  // Random vec2
  // ======================================================
  vec2 rand2(vec2 n) {
    float x = fract(sin(dot(n, vec2(12.9898, 78.233))) * 43758.5453);
    float y = fract(sin(dot(n, vec2(39.3467, 11.135))) * 96321.631);
    return vec2(x, y);
  }

  // ======================================================
  // Worley Cell Noise (dạng đốm giống Unity)
  // ======================================================
  float cellNoise(vec2 uv) {
    uv = uv * vec2(NoiseScaleX, NoiseScaleY) + vec2(NoiseOffsetX, NoiseOffsetY);

    vec2 i = floor(uv);
    vec2 f = fract(uv);

    float minDist = 10.0;

    for (int y = -1; y <= 1; y++) {
      for (int x = -1; x <= 1; x++) {
        vec2 neighbor = vec2(x, y);
        vec2 point = rand2(i + neighbor);
        float d = length(neighbor + point - f);
        minDist = min(minDist, d);
      }
    }

    // Ngưỡng đốm — mềm / cứng theo Unity
    return smoothstep(0.28, 0.38, minDist);
  }

  // ======================================================
  // Symmetry
  // ======================================================
  vec2 applySym(vec2 uv) {
    if (SymetryToggle > 0.5)
      uv.x = 1.0 - uv.x;
    return uv;
  }

  // ======================================================
  // Toon Lighting (giữ y như cũ)
  // ======================================================
  float toonLight(vec3 n) {
    vec3 L = normalize(vec3(0.3, 0.4, 1.0));
    float d = max(dot(n, L), 0.0);
    return step(0.5, d);
  }

  // ======================================================
  // FRAG MAIN
  // ======================================================
  vec4 frag() {
    vec2 uv = applySym(v_uv);

    vec4 color = SkinColor;

    // ------------------------------
    // Noise Toggle ON → dùng đốm mới
    // ------------------------------
    if (NoiseToggle > 0.5) {
      float mask = cellNoise(uv);
      color.rgb = mix(NoiseColor.rgb, color.rgb, mask);
    }

    // ------------------------------
    // Texture toggle giữ nguyên
    // ------------------------------
    if (TextureToggle > 0.5) {
      color *= texture(Texture2D, uv);
    }

    // ------------------------------
    // Toon lighting giữ lại
    // ------------------------------
    float t = toonLight(normalize(v_normal));
    color.rgb *= mix(1.0, 1.18, t);

    return CCFragOutput(color);
  }
}%
