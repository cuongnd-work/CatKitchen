// SpriteFill.effect
// Built on Cocos Creator builtin unlit template
// Isometric-like fill (diagonal) with always-on-top rendering behavior.

CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: general-vs:vert
      frag: sprite-fill-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties: &props
        mainTexture:    { value: white }
        mainColor:      { value: [1, 1, 1, 1], editor: { type: color } }
        fillAmount:     { value: 1.0 }
        alphaThreshold: { value: 0.001 }

  - name: transparent_alt
    passes:
    - vert: general-vs:vert
      frag: sprite-fill-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties: *props
}%

CCProgram sprite-fill-fs %{
  // 🔥 REQUIRED for GLSL ES (mobile)
  precision highp float;
  precision highp int;

  #include <legacy/output>
  #include <legacy/fog-fs>

  in vec2 v_uv;
  in vec3 v_position;

  uniform sampler2D mainTexture;

  uniform Constant {
    vec4  mainColor;
    float fillAmount;
    float alphaThreshold;
  };

  vec4 frag () {
    // Isometric-like diagonal fill:
    // 0.0 starts near lower-left, 1.0 reaches upper-right.
    float isoProgress = clamp((v_uv.x + v_uv.y) * 0.5, 0.0, 1.0);
    if (isoProgress > fillAmount) {
      discard;
    }

    vec4 col = mainColor * texture(mainTexture, v_uv);

    if (col.a <= alphaThreshold) {
      discard;
    }

    CC_APPLY_FOG(col, v_position);
    return CCFragOutput(col);
  }
}%
